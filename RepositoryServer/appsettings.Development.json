{
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Protocols": "Http1",
        "Url": "http://*:5080"
      }
    }
  },

  "//DevAuth": [
    "Skips the Authentik login and treats every caller as an administrator.",
    "Only has any effect in a Debug build running in the Development environment; the published",
    "image is built with -c Release and does not contain the handler at all."
  ],
  "DevAuth": {
    "BypassAuthentik": true,
    "Username": "dev-admin"
  },

  "//Db": "Port 5433 rather than 5432, so a local OpenShock API stack can keep the default port.",
  "Db": {
    "Conn": "Host=localhost;Port=5433;Database=repo-server;Username=openshock;Password=openshock"
  },

  "Repo": {
    "Id": "openshock-desktop-modules-dev",
    "Name": "OpenShock Modules (dev)",
    "Author": "OpenShock",
    "CdnBaseUrl": "http://localhost:5080/cdn"
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Verbose",
      "Override": {
        "Microsoft.Hosting.Lifetime": "Verbose",
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Verbose",
        "Serilog.AspNetCore.RequestLoggingMiddleware": "Information",
        "Microsoft.AspNetCore.Mvc.Infrastructure.ControllerActionInvoker": "Warning",
        "OpenShock": "Verbose"
      }
    }
  }
}
