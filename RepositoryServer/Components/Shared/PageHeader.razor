@*
    Page title, optional subtitle, optional right-aligned action cluster. Per the style guide §2.5:
    flex-wrap plus ml-auto is the whole responsive story, so on narrow screens the actions drop to
    their own line and stay right-aligned.

    The action wrapper is only emitted when there are actions — an empty cluster would still consume
    the parent's gap.
*@

<div class="mb-4 w-full">
    <div class="flex w-full flex-wrap items-center gap-x-2 gap-y-1">
        <h1 class="text-3xl font-bold">@Title</h1>

        @if (Actions is not null)
        {
            <div class="ml-auto flex flex-wrap items-center justify-end gap-1">
                @Actions
            </div>
        }
    </div>

    @if (Subtitle is not null)
    {
        <p class="text-muted-foreground mt-1">@Subtitle</p>
    }
</div>

@code {
    [Inject] private IJSRuntime JS { get; set; } = null!;

    [Parameter, EditorRequired] public required string Title { get; set; }

    /// <summary>Helper line under the title. Rendered as a RenderFragment so it can carry markup.</summary>
    [Parameter] public RenderFragment? Subtitle { get; set; }

    /// <summary>Right-aligned action buttons, if the page has any.</summary>
    [Parameter] public RenderFragment? Actions { get; set; }

    /// <summary>
    /// Keeps the browser tab in step with the page. Runs on every render rather than only the first,
    /// so an enhanced navigation between two pages updates the title rather than leaving the
    /// previous page's.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("setDocumentTitle", $"{Title} · Repository Server");
    }
}
