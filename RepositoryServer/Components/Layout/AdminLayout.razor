@inherits LayoutComponentBase
@inject AdminAuthMode AuthMode

@*
    Hosts have to live in the layout rather than a page: toasts and dialogs raised by a page are
    rendered by these, so they need to outlive the page that opened them. BbPortalHost is what
    every floating element (dropdowns, popovers, dialog overlays) renders into.
*@
<BbPortalHost/>
<BbDialogProvider/>
@* Style guide §5: request-level errors go to a toast, top-center. *@
<BbToastProvider Position="ToastPosition.TopCenter" PauseOnHover="true"/>

<BbTooltipProvider>
    <BbSidebarProvider>
        <BbSidebar>
            <BbSidebarHeader>
                <a href="/admin" class="flex items-center gap-2 px-2 py-1.5 font-semibold">
                    Repository Server
                </a>
            </BbSidebarHeader>

            <BbSidebarContent>
                @*
                    Shared first, then one section per distribution domain. Publishers and Discord
                    webhooks sit in the shared group because both are genuinely cross-domain: the
                    repositories table is the publish allowlist for firmware and desktop alike, and
                    both notify through the same webhooks.
                *@
                <BbSidebarGroup>
                    <BbSidebarGroupLabel>Shared</BbSidebarGroupLabel>
                    <BbSidebarGroupContent>
                        <BbSidebarMenu>
                            <BbSidebarMenuItem>
                                <BbSidebarMenuButton Href="/admin" Match="NavLinkMatch.All">
                                    Status
                                </BbSidebarMenuButton>
                            </BbSidebarMenuItem>
                            <BbSidebarMenuItem>
                                <BbSidebarMenuButton Href="/admin/repositories">
                                    Publishers
                                </BbSidebarMenuButton>
                            </BbSidebarMenuItem>
                            <BbSidebarMenuItem>
                                <BbSidebarMenuButton Href="/admin/discord-webhooks">
                                    Discord
                                </BbSidebarMenuButton>
                            </BbSidebarMenuItem>
                        </BbSidebarMenu>
                    </BbSidebarGroupContent>
                </BbSidebarGroup>

                <BbSidebarGroup>
                    <BbSidebarGroupLabel>Firmware</BbSidebarGroupLabel>
                    <BbSidebarGroupContent>
                        <BbSidebarMenu>
                            <BbSidebarMenuItem>
                                <BbSidebarMenuButton Href="/admin/firmware/releases">Releases</BbSidebarMenuButton>
                            </BbSidebarMenuItem>
                            <BbSidebarMenuItem>
                                <BbSidebarMenuButton Href="/admin/firmware/boards">Boards</BbSidebarMenuButton>
                            </BbSidebarMenuItem>
                            <BbSidebarMenuItem>
                                <BbSidebarMenuButton Href="/admin/firmware/chips">Chips</BbSidebarMenuButton>
                            </BbSidebarMenuItem>
                            <BbSidebarMenuItem>
                                <BbSidebarMenuButton Href="/admin/firmware/usb-devices">USB devices</BbSidebarMenuButton>
                            </BbSidebarMenuItem>
                            <BbSidebarMenuItem>
                                <BbSidebarMenuButton Href="/admin/firmware/usb-serial-filters">Serial filters</BbSidebarMenuButton>
                            </BbSidebarMenuItem>
                            <BbSidebarMenuItem>
                                <BbSidebarMenuButton Href="/admin/firmware/advisories">Advisories</BbSidebarMenuButton>
                            </BbSidebarMenuItem>
                        </BbSidebarMenu>
                    </BbSidebarGroupContent>
                </BbSidebarGroup>

                <BbSidebarGroup>
                    <BbSidebarGroupLabel>Desktop</BbSidebarGroupLabel>
                    <BbSidebarGroupContent>
                        <BbSidebarMenu>
                            <BbSidebarMenuItem>
                                <BbSidebarMenuButton Href="/admin/desktop/modules">Modules</BbSidebarMenuButton>
                            </BbSidebarMenuItem>
                        </BbSidebarMenu>
                    </BbSidebarGroupContent>
                </BbSidebarGroup>
            </BbSidebarContent>

            <BbSidebarFooter>
                <AuthorizeView>
                    <Authorized>
                        <div class="px-2 py-1.5 text-sm text-muted-foreground">
                            @context.User.Identity?.Name
                        </div>
                        <BbButton Href="/auth/logout" Variant="ButtonVariant.Ghost" Size="ButtonSize.Small"
                                  Class="w-full justify-start">
                            Sign out
                        </BbButton>
                    </Authorized>
                </AuthorizeView>
            </BbSidebarFooter>
        </BbSidebar>

        @*
            Shell per style guide §2.1: a full-viewport, non-scrolling frame with exactly one scroll
            container inside it. main is flex-1 min-h-0 — without min-h-0 a flex child refuses to
            shrink below its content and the page grows instead of scrolling.
        *@
        <BbSidebarInset Class="flex h-screen flex-col overflow-hidden">
            @*
                Red rather than the guide's orangered: this is not "you are on dev", it is "this
                server currently has no authentication at all", which is the same severity as a
                destructive action. Uses the destructive token so it tracks the theme.
            *@
            @if (AuthMode.DevBypass)
            {
                <div class="bg-destructive flex flex-none items-center justify-center gap-2 px-3 py-1.5
                            text-sm font-medium text-white" role="alert">
                    <svg xmlns="http://www.w3.org/2000/svg" class="size-4 shrink-0" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                         stroke-linejoin="round" aria-hidden="true">
                        <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"/>
                        <path d="M12 9v4"/><path d="M12 17h.01"/>
                    </svg>
                    <span>
                        Authentication is disabled. Every request to this server is being granted full
                        administrator access without a login — do not expose it to a network.
                    </span>
                </div>
            }

            @*
                Style guide §2.2: sidebar toggle, vertical separator, breadcrumbs, elastic spacer,
                then identity. The breadcrumb is derived from the route rather than passed down by
                each page, so a new page cannot forget to set it.
            *@
            <header class="flex h-12 shrink-0 items-center gap-2 border-b px-3">
                <BbSidebarTrigger/>
                <hr class="mr-2 h-4 w-px"/>

                <nav aria-label="Breadcrumb" class="flex shrink-0 items-center gap-1.5 text-sm">
                    @foreach (var (crumb, isLast) in Breadcrumbs())
                    {
                        @if (isLast)
                        {
                            <span class="font-medium" aria-current="page">@crumb</span>
                        }
                        else
                        {
                            <span class="text-muted-foreground">@crumb</span>
                            <span class="text-muted-foreground" aria-hidden="true">/</span>
                        }
                    }
                </nav>

                <div class="flex-1"></div>

                <AuthorizeView>
                    <Authorized>
                        <span class="text-muted-foreground hidden text-sm lg:inline-block">
                            @context.User.Identity?.Name
                        </span>
                    </Authorized>
                </AuthorizeView>
            </header>

            <main class="min-h-0 flex-1 overflow-x-hidden">
                @*
                    The page container, §2.4. Pages are its direct children and inherit the gap-4,
                    which is why they carry no vertical margins of their own.
                *@
                <div class="container mx-auto flex h-full flex-col items-start justify-start gap-4
                            px-4 pt-4 pb-1 sm:px-12 sm:pt-12 sm:pb-2">
                    @Body
                </div>
            </main>
        </BbSidebarInset>
    </BbSidebarProvider>
</BbTooltipProvider>

@code {
    [Inject] private NavigationManager Navigation { get; set; } = null!;

    /// <summary>
    /// Route segments after the origin, title-cased, with the last one flagged as current. Derived
    /// from the URL so a page cannot forget to declare its own trail.
    /// </summary>
    private IEnumerable<(string Crumb, bool IsLast)> Breadcrumbs()
    {
        var path = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?')[0].Trim('/');

        var segments = path.Split('/', StringSplitOptions.RemoveEmptyEntries)
            .Select(Humanize)
            .ToArray();

        // "/admin" on its own is the dashboard; name it so the bar is never a single word.
        if (segments.Length == 1) segments = [segments[0], "Status"];

        for (var i = 0; i < segments.Length; i++)
        {
            yield return (segments[i], i == segments.Length - 1);
        }
    }

    private static string Humanize(string segment) => segment switch
    {
        "admin" => "Administration",
        "usb-devices" => "USB devices",
        "usb-serial-filters" => "Serial filters",
        "repositories" => "Publishers",
        "discord-webhooks" => "Discord webhooks",
        _ => string.Concat(char.ToUpperInvariant(segment[0]), segment[1..].Replace('-', ' '))
    };
}
