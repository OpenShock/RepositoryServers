@page "/admin/firmware/usb-serial-filters"
@attribute [Authorize(Policy = AuthSchemas.Policies.Admin)]
@inherits AdminPageBase

<PageHeader Title="USB serial filters">
    <Subtitle>
        WebSerial port picker rules. Leaving the PID empty matches an entire vendor, and there can only be
        one vendor-wide row per VID.
    </Subtitle>
    <Actions>
        <BbButton OnClick="OpenCreate">Add filter</BbButton>
    </Actions>
</PageHeader>

<BbCard Class="w-full overflow-hidden p-0">
        <BbDataGrid TData="UsbSerialFilter" Items="_filters" IsLoading="_loading" Striped="true"
                    StickyHeader="true">
            <EmptyTemplate>
                <div class="flex flex-col items-center gap-3 py-12 text-center">
                    <p class="text-muted-foreground">No filters yet.</p>
                    <BbButton Variant="ButtonVariant.Outline" OnClick="OpenCreate">Add the first filter</BbButton>
                </div>
            </EmptyTemplate>
            <Columns>
                <BbDataGridPropertyColumn TData="UsbSerialFilter" TProp="int" Property="f => f.Vid" Title="VID">
                    <CellTemplate>
                        <code>@Hex(context.Vid)</code>
                    </CellTemplate>
                </BbDataGridPropertyColumn>
                <BbDataGridTemplateColumn TData="UsbSerialFilter" Title="PID">
                    @if (context.Pid is { } pid)
                    {
                        <code>@Hex(pid)</code>
                    }
                    else
                    {
                        <BbBadge Variant="BadgeVariant.Secondary">any</BbBadge>
                    }
                </BbDataGridTemplateColumn>
                <BbDataGridPropertyColumn TData="UsbSerialFilter" TProp="string" Property="f => f.Description"
                                          Title="Description"/>
                <BbDataGridTemplateColumn TData="UsbSerialFilter" Title="" Sortable="false" Width="0">
                    <div class="flex justify-end gap-1">
                        <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.IconSmall" OnClick="() => OpenEdit(context)" AriaLabel="Edit" title="Edit">
                        <Glyph Name="IconName.Pencil"/>
                    </BbButton>
                        <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.IconSmall" Class="text-destructive" OnClick="() => DeleteAsync(context)" AriaLabel="Delete" title="Delete">
                        <Glyph Name="IconName.Trash"/>
                    </BbButton>
                    </div>
                </BbDataGridTemplateColumn>
            </Columns>
    </BbDataGrid>
</BbCard>

<BbDialog @bind-Open="_formOpen">
    <BbDialogContent Class="sm:max-w-md">
        <BbDialogHeader>
            <BbDialogTitle>@(_editing ? "Edit filter" : "Add a filter")</BbDialogTitle>
            <BbDialogDescription>
                Leaving the PID empty matches an entire vendor, and there can only be one vendor-wide
                row per VID.
            </BbDialogDescription>
        </BbDialogHeader>

        <div class="flex flex-col gap-4 py-2">
            <div class="flex flex-col gap-2">
                <BbLabel For="vid">VID</BbLabel>
                <BbInput Id="vid" @bind-Value="_vid" Placeholder="0x1A86"/>
            </div>
            <div class="flex flex-col gap-2">
                <BbLabel For="pid">PID</BbLabel>
                <BbInput Id="pid" @bind-Value="_pid" Placeholder="0x7522"/>
                <p class="text-muted-foreground text-xs">Empty matches the whole vendor.</p>
            </div>
            <div class="flex flex-col gap-2">
                <BbLabel For="description">Description</BbLabel>
                <BbInput Id="description" @bind-Value="_description" Placeholder="QinHeng CH340"/>
            </div>
        </div>

        <BbDialogFooter>
            <BbButton Variant="ButtonVariant.Outline" OnClick="() => _formOpen = false">Cancel</BbButton>
            <BbButton OnClick="UpsertAsync">Save</BbButton>
        </BbDialogFooter>
    </BbDialogContent>
</BbDialog>

@code {
    private UsbSerialFilter[] _filters = [];
    private bool _loading = true;

    private bool _formOpen;
    private bool _editing;
    private string _vid = string.Empty;
    private string? _pid;
    private string? _description;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        await using var scope = CreateScope();
        _filters = await scope.Get<CatalogAdminService>().ListUsbSerialFiltersAsync();
        _loading = false;
    }

    private static string Hex(int value) => $"0x{value:X4}";

    private void OpenCreate()
    {
        _editing = false;
        ResetForm();
        _formOpen = true;
    }

    private void OpenEdit(UsbSerialFilter filter)
    {
        _editing = true;
        _formOpen = true;
        _vid = Hex(filter.Vid);
        _pid = filter.Pid is { } pid ? Hex(pid) : null;
        _description = filter.Description;
    }

    private void ResetForm()
    {
        _vid = string.Empty;
        _pid = null;
        _description = null;
    }

    private async Task UpsertAsync()
    {
        if (!UsbIdentifier.TryParse(_vid, out var vid))
        {
            ReportError("VID and PID must be numbers, in hex (0x1A86) or decimal.");
            return;
        }

        int? pid = null;
        if (!string.IsNullOrWhiteSpace(_pid))
        {
            if (!UsbIdentifier.TryParse(_pid, out var parsedPid))
            {
                ReportError("VID and PID must be numbers, in hex (0x1A86) or decimal.");
                return;
            }

            pid = parsedPid;
        }

        var description = string.IsNullOrWhiteSpace(_description) ? null : _description;

        await using (var scope = CreateScope())
        {
            await scope.Get<CatalogAdminService>().UpsertUsbSerialFilterAsync(vid, pid, description);
        }

        Report(null, "Saved.");
        _formOpen = false;
        ResetForm();
        await LoadAsync();
    }

    private async Task DeleteAsync(UsbSerialFilter filter)
    {
        var label = filter.Pid is { } pid ? $"{Hex(filter.Vid)}:{Hex(pid)}" : $"{Hex(filter.Vid)}:any";
        if (!await ConfirmAsync("Delete filter", $"Delete the filter for {label}?")) return;

        await using var scope = CreateScope();
        var result = await scope.Get<CatalogAdminService>().DeleteUsbSerialFilterAsync(filter.Id);

        Report(
            result.Match<string?>(
                _ => null,
                _ => "That filter no longer exists."),
            "Deleted.");
        await LoadAsync();
    }
}
