@page "/admin/desktop/modules/{ModuleId}"
@attribute [Authorize(Policy = AuthSchemas.Policies.Admin)]
@using System.Diagnostics.CodeAnalysis
@using OpenShock.RepositoryServer.RepoServerDb.Models
@inherits AdminDataPageBase

<PageHeader Title="@(_module?.Name ?? ModuleId)">
    <Subtitle>
        Everything the desktop index advertises for <code>@ModuleId</code>. Versions are normally
        written by the module's CI, which uploads the zip and refuses to overwrite a version that
        exists; what is here is the administrative override for correcting a row or registering a zip
        this server did not upload.
    </Subtitle>
    <Actions>
        <BbButton Variant="ButtonVariant.Outline" Href="/admin/desktop/modules">All modules</BbButton>
        @if (_module is not null)
        {
            <BbButton Variant="ButtonVariant.Outline" OnClick="OpenEditModule">Edit module</BbButton>
            <BbButton OnClick="OpenCreateVersion">Add version</BbButton>
        }
    </Actions>
</PageHeader>

@* Style guide §5: the read is page-wide here, so the loading state is one centred spinner. *@
@if (Loading)
{
    <div class="flex w-full items-center justify-center py-12">
        <BbSpinner Class="size-8"/>
    </div>
}
else if (_module is null)
{
    <BbAlert Variant="AlertVariant.Warning">
        No module with the id <code>@ModuleId</code>. It was either deleted or never created.
    </BbAlert>
}
else
{
    <BbCard Class="w-full p-4">
        <div class="flex flex-col gap-3">
            <div class="flex flex-wrap items-center gap-2">
                <span class="text-muted-foreground w-40 shrink-0 text-sm">Id</span>
                <code>@_module.Id</code>
            </div>
            <div class="flex flex-wrap items-center gap-2">
                <span class="text-muted-foreground w-40 shrink-0 text-sm">Owning repository</span>
                @if (OwnerName(_module.RepositoryId) is { } owner)
                {
                    <span>@owner</span>
                }
                else
                {
                    @* The publisher story is the point of this row, so the reason is spelled out. *@
                    <BbBadge Variant="BadgeVariant.Destructive">unassigned</BbBadge>
                    <span class="text-muted-foreground text-sm">no CI may publish to this module</span>
                }
            </div>
            <div class="flex flex-wrap items-center gap-2">
                <span class="text-muted-foreground w-40 shrink-0 text-sm">Description</span>
                <span>@(string.IsNullOrWhiteSpace(_module.Description) ? "—" : _module.Description)</span>
            </div>
            <div class="flex flex-wrap items-center gap-2">
                <span class="text-muted-foreground w-40 shrink-0 text-sm">Source</span>
                @if (_module.SourceUrl is { } sourceUrl)
                {
                    <a href="@sourceUrl" class="underline" target="_blank" rel="noreferrer">@sourceUrl</a>
                }
                else
                {
                    <span class="text-muted-foreground">—</span>
                }
            </div>
            <div class="flex flex-wrap items-center gap-2">
                <span class="text-muted-foreground w-40 shrink-0 text-sm">Icon</span>
                @if (_module.IconUrl is { } iconUrl)
                {
                    <a href="@iconUrl" class="underline" target="_blank" rel="noreferrer">@iconUrl</a>
                }
                else
                {
                    <span class="text-muted-foreground">—</span>
                }
            </div>
        </div>
    </BbCard>

    <h2 class="text-lg font-semibold">Published versions</h2>
    <p class="mb-4 text-sm text-muted-foreground">
        Newest first, by semantic version rather than by name. Withdrawing one removes it from the
        index; the zip stays in storage so a client mid-download is not cut off.
    </p>

    <BbCard Class="w-full overflow-hidden p-0">
        @* No IsLoading: this whole block only renders once the read has finished. *@
        <BbDataGrid TData="VersionRow" Items="_versions" Striped="true" StickyHeader="true">
            <EmptyTemplate>
                <div class="flex flex-col items-center gap-3 py-12 text-center">
                    <p class="text-muted-foreground">
                        Nothing published. The module's CI publishes here once it is wired up.
                    </p>
                    <BbButton Variant="ButtonVariant.Outline" OnClick="OpenCreateVersion">
                        Register a version by hand
                    </BbButton>
                </div>
            </EmptyTemplate>
            <Columns>
                <BbDataGridPropertyColumn TData="VersionRow" TProp="string" Property="v => v.Name"
                                          Title="Version" Sortable="false">
                    <CellTemplate>
                        <div class="flex flex-wrap items-center gap-2">
                            <code>@context.Name</code>
                            @if (!context.Parseable)
                            {
                                @* The index parses every stored version, so this row breaks it. *@
                                <BbBadge Variant="BadgeVariant.Destructive">not semver</BbBadge>
                            }
                            else if (context.IsPrerelease)
                            {
                                <BbBadge Variant="BadgeVariant.Secondary">pre-release</BbBadge>
                            }
                        </div>
                    </CellTemplate>
                </BbDataGridPropertyColumn>
                <BbDataGridTemplateColumn TData="VersionRow" Title="Zip" Sortable="false">
                    <a href="@context.ZipUrl" class="underline" target="_blank" rel="noreferrer"
                       title="@context.ZipUrl">@Shorten(context.ZipUrl)</a>
                </BbDataGridTemplateColumn>
                <BbDataGridTemplateColumn TData="VersionRow" Title="SHA-256" Sortable="false">
                    <span class="font-mono text-xs text-muted-foreground" title="@context.Hash">
                        @(context.Hash[..16])…
                    </span>
                </BbDataGridTemplateColumn>
                <BbDataGridTemplateColumn TData="VersionRow" Title="Links" Sortable="false">
                    <div class="flex flex-wrap items-center gap-2">
                        @if (context.ChangelogUrl is { } changelogUrl)
                        {
                            <a href="@changelogUrl" class="text-sm underline" target="_blank"
                               rel="noreferrer">changelog</a>
                        }
                        @if (context.ReleaseUrl is { } releaseUrl)
                        {
                            <a href="@releaseUrl" class="text-sm underline" target="_blank"
                               rel="noreferrer">release</a>
                        }
                        @if (context is { ChangelogUrl: null, ReleaseUrl: null })
                        {
                            <span class="text-muted-foreground">—</span>
                        }
                    </div>
                </BbDataGridTemplateColumn>
                <BbDataGridTemplateColumn TData="VersionRow" Title="" Sortable="false" Width="0">
                    <div class="flex justify-end gap-1">
                        <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.IconSmall" OnClick="() => OpenEditVersion(context)" AriaLabel="Edit" title="Edit">
                            <Glyph Name="IconName.Pencil"/>
                        </BbButton>
                        <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.IconSmall" Class="text-destructive" OnClick="() => DeleteVersionAsync(context)" AriaLabel="Withdraw" title="Withdraw">
                            <Glyph Name="IconName.Trash"/>
                        </BbButton>
                    </div>
                </BbDataGridTemplateColumn>
            </Columns>
        </BbDataGrid>
    </BbCard>

    <div class="flex w-full justify-end">
        <BbButton Variant="ButtonVariant.Outline" Class="text-destructive" OnClick="DeleteModuleAsync">
            Delete module
        </BbButton>
    </div>
}

<ModuleFormDialog @bind-Open="_moduleFormOpen" Model="_moduleForm" Repositories="_repositories"
                  IdLocked="true" OnSave="SaveModuleAsync"/>

<BbDialog @bind-Open="_versionFormOpen">
    <BbDialogContent Class="sm:max-w-lg">
        <BbDialogHeader>
            <BbDialogTitle>
                @(_editingVersion ? $"Edit {_versionForm.Name}" : "Register a version")
            </BbDialogTitle>
            <BbDialogDescription>
                This writes only the row that advertises the zip — no bytes are uploaded or moved, and
                nothing verifies the digest against the file, so it has to be the digest of the zip at
                that URL or every install of this version fails.
            </BbDialogDescription>
        </BbDialogHeader>

        <div class="flex flex-col gap-4 py-2">
            <div class="flex flex-col gap-2">
                <BbLabel For="version-name">Version</BbLabel>
                <BbInput Id="version-name" @bind-Value="_versionForm.Name" Disabled="_editingVersion"
                         Placeholder="1.4.0"/>
                <p class="text-muted-foreground text-xs">
                    Strict semantic versioning. The index parses every stored version, so one that does
                    not parse breaks the whole index rather than only itself.
                </p>
            </div>
            <div class="flex flex-col gap-2">
                <BbLabel For="version-zip">Zip URL</BbLabel>
                <BbInput Id="version-zip" @bind-Value="_versionForm.ZipUrl"
                         Placeholder="https://cdn.example.com/modules/id/1.4.0/module.zip"/>
            </div>
            <div class="flex flex-col gap-2">
                <BbLabel For="version-hash">SHA-256</BbLabel>
                <BbInput Id="version-hash" @bind-Value="_versionForm.Hash" Class="font-mono"
                         Placeholder="64 hex characters"/>
            </div>
            <div class="flex flex-col gap-2">
                <BbLabel For="version-changelog">Changelog URL</BbLabel>
                <BbInput Id="version-changelog" @bind-Value="_versionForm.ChangelogUrl"/>
            </div>
            <div class="flex flex-col gap-2">
                <BbLabel For="version-release">Release URL</BbLabel>
                <BbInput Id="version-release" @bind-Value="_versionForm.ReleaseUrl"/>
            </div>
        </div>

        <BbDialogFooter>
            <BbButton Variant="ButtonVariant.Outline" OnClick="() => _versionFormOpen = false">Cancel</BbButton>
            <BbButton OnClick="SaveVersionAsync">Save</BbButton>
        </BbDialogFooter>
    </BbDialogContent>
</BbDialog>

@code {
    [Inject] private NavigationManager Navigation { get; set; } = null!;

    /// <summary>The module's id, from the route. Ids are lowercased by the service.</summary>
    [Parameter, EditorRequired] public required string ModuleId { get; set; }

    private Module? _module;
    private SourceRepository[] _repositories = [];
    private VersionRow[] _versions = [];

    /// <summary>
    /// Which module the fields above hold. The router reuses this component when one module page
    /// links to another, and OnInitialized does not run a second time, so the read is keyed on this
    /// rather than on the component's lifetime.
    /// </summary>
    private string? _loaded;

    private bool _moduleFormOpen;
    private ModuleFormModel _moduleForm = new();

    private bool _versionFormOpen;
    private bool _editingVersion;
    private VersionFormModel _versionForm = new();

    protected override async Task LoadDataAsync(AsyncServiceScope scope)
    {
        _loaded = ModuleId;
        _module = await scope.Get<ModuleAdminService>().FindAsync(ModuleId);
        _repositories = await scope.Get<PublisherAdminService>().ListAsync();

        _versions = _module is null
            ? []
            : ModuleVersions.NewestFirst(_module.Versions).Select(VersionRow.From).ToArray();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_loaded != ModuleId) await ReloadAsync();
    }

    private string? OwnerName(Guid? repositoryId)
    {
        if (repositoryId is not { } id) return null;
        var repository = _repositories.FirstOrDefault(r => r.Id == id);
        return repository is null ? null : $"{repository.Owner}/{repository.Repo}";
    }

    /// <summary>Keeps a URL to one line in a cell; the full value stays in the title attribute.</summary>
    private static string Shorten(string url) => url.Length <= 56 ? url : $"{url[..53]}…";

    private void OpenEditModule()
    {
        if (_module is null) return;

        _moduleForm = ModuleFormModel.From(_module);
        _moduleFormOpen = true;
    }

    private async Task SaveModuleAsync()
    {
        if (!_moduleForm.TryGetValues(out var values, out var error))
        {
            ReportError(error);
            return;
        }

        _moduleFormOpen = false;

        await MutateAsync(async scope =>
        {
            var result = await scope.Get<ModuleAdminService>().UpsertAsync(
                values.Id, values.Name, values.Description, values.SourceUrl, values.IconUrl,
                values.RepositoryId);

            Report(
                result.Match<string?>(
                    _ => null,
                    missing => $"No such {missing.Reference}."),
                "Saved.");
        });
    }

    private async Task DeleteModuleAsync()
    {
        if (_module is null) return;

        var confirmed = await ConfirmAsync(
            "Delete module",
            $"Delete {_module.Id}? Its {_module.Versions.Count} published version(s) go with it.");

        if (!confirmed) return;

        var deleted = false;

        await MutateAsync(async scope =>
        {
            var result = await scope.Get<ModuleAdminService>().DeleteAsync(ModuleId);
            deleted = result.IsT0;

            Report(
                result.Match<string?>(
                    _ => null,
                    _ => "That module no longer exists."),
                "Deleted.");
        });

        // This page is now about something that does not exist, so it cannot be what the admin is
        // left looking at.
        if (deleted) Navigation.NavigateTo("/admin/desktop/modules");
    }

    private void OpenCreateVersion()
    {
        _editingVersion = false;
        _versionForm = new VersionFormModel();
        _versionFormOpen = true;
    }

    private void OpenEditVersion(VersionRow version)
    {
        _editingVersion = true;
        _versionForm = VersionFormModel.From(version);
        _versionFormOpen = true;
    }

    private async Task SaveVersionAsync()
    {
        if (!_versionForm.TryGetValues(out var values, out var error))
        {
            ReportError(error);
            return;
        }

        _versionFormOpen = false;

        await MutateAsync(async scope =>
        {
            var result = await scope.Get<ModuleAdminService>().UpsertVersionAsync(
                ModuleId, values.Name, values.ZipUrl, values.Hash, values.ChangelogUrl,
                values.ReleaseUrl);

            Report(
                result.Match<string?>(
                    _ => null,
                    missing => $"No such {missing.Reference}.",
                    invalid => $"{invalid.Version} is not a strict semantic version.",
                    _ => "The SHA-256 must be 64 hex characters."),
                $"Saved {values.Name}.");
        });
    }

    private async Task DeleteVersionAsync(VersionRow version)
    {
        var confirmed = await ConfirmAsync(
            "Withdraw version",
            $"Withdraw {ModuleId} {version.Name} from the index?",
            confirmText: "Withdraw");

        if (!confirmed) return;

        await MutateAsync(async scope =>
        {
            var result = await scope.Get<ModuleAdminService>().DeleteVersionAsync(ModuleId, version.Name);

            Report(
                result.Match<string?>(
                    _ => null,
                    _ => "That version no longer exists."),
                $"Withdrew {version.Name}.");
        });
    }

    /// <summary>
    /// One row of the versions grid. A projection rather than the entity: the grid and the form both
    /// want the digest as hex and the URLs as strings, and the entity's type name collides with
    /// <see cref="System.Version"/> in a Razor file.
    /// </summary>
    private sealed record VersionRow(
        string Name, string ZipUrl, string Hash, string? ChangelogUrl, string? ReleaseUrl,
        bool Parseable, bool IsPrerelease)
    {
        public static VersionRow From(RepoServerDb.Models.Version version)
        {
            var parsed = ModuleVersions.Parse(version.VersionName);

            return new VersionRow(
                version.VersionName,
                version.ZipUrl.ToString(),
                FormValues.ToHex(version.HashSha256),
                version.ChangelogUrl?.ToString(),
                version.ReleaseUrl?.ToString(),
                parsed is not null,
                parsed?.IsPrerelease ?? false);
        }
    }

    private sealed record VersionFormValues(
        string Name, Uri ZipUrl, byte[] Hash, Uri? ChangelogUrl, Uri? ReleaseUrl);

    /// <summary>What the version dialog binds to. Everything is text until it is saved.</summary>
    private sealed class VersionFormModel
    {
        public string Name { get; set; } = string.Empty;
        public string? ZipUrl { get; set; }
        public string? Hash { get; set; }
        public string? ChangelogUrl { get; set; }
        public string? ReleaseUrl { get; set; }

        public static VersionFormModel From(VersionRow row) => new()
        {
            Name = row.Name,
            ZipUrl = row.ZipUrl,
            Hash = row.Hash,
            ChangelogUrl = row.ChangelogUrl,
            ReleaseUrl = row.ReleaseUrl
        };

        /// <summary>
        /// Parses the form. The semver check is the service's, because a row that does not parse is a
        /// data problem rather than a typing one; what is refused here is only what the service
        /// cannot be handed at all.
        /// </summary>
        public bool TryGetValues(
            [NotNullWhen(true)] out VersionFormValues? values, [NotNullWhen(false)] out string? error)
        {
            values = null;

            if (string.IsNullOrWhiteSpace(Name))
            {
                error = "A version is required.";
                return false;
            }

            if (!FormValues.TryParseUri(ZipUrl, out var zipUrl) || zipUrl is null)
            {
                error = "The zip URL is required, and must be absolute.";
                return false;
            }

            if (!FormValues.TryParseSha256(Hash, out var hash))
            {
                error = "The SHA-256 must be 64 hex characters.";
                return false;
            }

            if (!FormValues.TryParseUri(ChangelogUrl, out var changelogUrl) ||
                !FormValues.TryParseUri(ReleaseUrl, out var releaseUrl))
            {
                error = "Changelog and release must be absolute URLs, or left empty.";
                return false;
            }

            values = new VersionFormValues(Name.Trim(), zipUrl, hash, changelogUrl, releaseUrl);
            error = null;
            return true;
        }
    }
}
