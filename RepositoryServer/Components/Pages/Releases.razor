@page "/admin/firmware/releases"
@attribute [Authorize(Policy = AuthSchemas.Policies.Admin)]
@inject ReleaseAdminService ReleaseService

<h2>Releases</h2>

<p class="muted">
    Releases CI created but has not published. A release whose changelog failed to parse lands in
    <code>editing</code> and cannot be published until the notes are fixed here, which returns it to
    <code>staging</code>.
</p>

<StatusAlert Error="@_error" Message="@_message"/>

<table>
    <thead>
    <tr>
        <th>Version</th>
        <th>Channel</th>
        <th>Status</th>
        <th>Created</th>
        <th>Notes</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var release in _releases)
    {
        <tr>
            <td><code>@release.Version</code></td>
            <td>@release.Channel.ToString().ToLowerInvariant()</td>
            <td>@release.Status.ToString().ToLowerInvariant()</td>
            <td class="muted">@release.CreatedAt.ToString("u")</td>
            <td class="muted">@NoteCount(release.Id)</td>
        </tr>
    }
    @if (_releases.Length == 0)
    {
        <tr>
            <td colspan="5" class="empty">Nothing in flight.</td>
        </tr>
    }
    </tbody>
</table>

@if (_releases.Length > 0)
{
    <h3>Fix a changelog</h3>

    <p class="muted">
        Markdown with <code>### Heading</code> sections. Replaces the staged notes wholesale and puts
        the release back into <code>staging</code>.
    </p>

    <EditForm FormName="fix-changelog" Model="ChangelogInput!" OnValidSubmit="FixChangelogAsync" class="stack">
        <AntiforgeryToken/>
        <label>
            Release
            <InputSelect @bind-Value="ChangelogInput!.ReleaseId">
                <option value="">select</option>
                @foreach (var release in _releases)
                {
                    <option value="@release.Id">@release.Version (@release.Status.ToString().ToLowerInvariant())</option>
                }
            </InputSelect>
        </label>
        <label>
            Changelog
            <InputTextArea @bind-Value="ChangelogInput!.Changelog" rows="10"
                           placeholder="### Breaking&#10;**Config format** — Changed to TOML&#10;&#10;### Info&#10;- Fixed WiFi reconnection"/>
        </label>
        <button type="submit">Save and return to staging</button>
    </EditForm>
}

<h3>Published versions</h3>

<p class="muted">
    Removing a version stops it being served. Artifacts stay in storage: they are immutable, and a
    version is normally pulled because it is bad rather than because the bytes must disappear.
</p>

<table>
    <thead>
    <tr>
        <th>Version</th>
        <th>Channel</th>
        <th>Released</th>
        <th></th>
    </tr>
    </thead>
    <tbody>
    @foreach (var version in _versions)
    {
        <tr>
            <td><code>@version.Version</code></td>
            <td>@version.Channel.ToString().ToLowerInvariant()</td>
            <td class="muted">@version.ReleaseDate.ToString("u")</td>
            <td>
                <EditForm FormName="@($"delete-version-{version.Version}")" Model="_actionModel"
                          OnValidSubmit="() => DeleteVersionAsync(version.Version)">
                    <AntiforgeryToken/>
                    <button type="submit" class="danger">Unpublish</button>
                </EditForm>
            </td>
        </tr>
    }
    @if (_versions.Length == 0)
    {
        <tr>
            <td colspan="4" class="empty">Nothing published yet.</td>
        </tr>
    }
    </tbody>
</table>

@code {
    private FirmwareRelease[] _releases = [];
    private FirmwareVersion[] _versions = [];
    private Dictionary<Guid, int> _noteCounts = new();
    private string? _error;
    private string? _message;

    // No initializer: the binder assigns this on every post and would overwrite one with null (BL0008).
    [SupplyParameterFromForm(FormName = "fix-changelog")]
    private ChangelogInputModel? ChangelogInput { get; set; }

    /// <summary>Satisfies EditForm on the row buttons, which carry an id and no fields.</summary>
    private readonly EmptyInput _actionModel = new();

    protected override async Task OnInitializedAsync()
    {
        ChangelogInput ??= new ChangelogInputModel();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _releases = await ReleaseService.ListEditableAsync();
        _versions = await ReleaseService.ListVersionsAsync();

        _noteCounts = new Dictionary<Guid, int>();
        foreach (var release in _releases)
        {
            var notes = await ReleaseService.ListStagedNotesAsync(release.Id);
            _noteCounts[release.Id] = notes.Length;
        }
    }

    private string NoteCount(Guid releaseId) =>
        _noteCounts.TryGetValue(releaseId, out var count)
            ? count == 0 ? "none, needs a changelog" : $"{count} section(s)"
            : "unknown";

    private async Task FixChangelogAsync()
    {
        if (ChangelogInput!.ReleaseId is not { } releaseId)
        {
            Report("Pick a release.", string.Empty);
            return;
        }

        var result = await ReleaseService.FixChangelogAsync(releaseId, ChangelogInput.Changelog);

        Report(
            result.Match<string?>(
                _ => null,
                _ => "That release no longer exists.",
                notEditable => $"Release is {notEditable.Status.ToString().ToLowerInvariant()}, " +
                               "which cannot be edited.",
                invalid => ChangelogMessage(invalid)),
            "Saved. The release is back in staging and can be published.");

        ChangelogInput = new ChangelogInputModel();
        await LoadAsync();
    }

    private static string ChangelogMessage(InvalidChangelog invalid) => invalid.Error switch
    {
        ChangelogParseError.Empty => "Changelog is empty or whitespace-only.",
        ChangelogParseError.NoHeadings => "Changelog contains no '### Heading' sections.",
        ChangelogParseError.AllSectionsEmpty => "All changelog sections are empty.",
        _ => $"Changelog could not be parsed ({invalid.Error})."
    };

    private async Task DeleteVersionAsync(string version)
    {
        var result = await ReleaseService.DeleteVersionAsync(version);

        Report(
            result.Match<string?>(
                _ => null,
                _ => "That version no longer exists."),
            $"Unpublished {version}.");

        await LoadAsync();
    }

    private void Report(string? error, string success)
    {
        _error = error;
        _message = error is null ? success : null;
    }

    private sealed class ChangelogInputModel
    {
        public Guid? ReleaseId { get; set; }
        public string Changelog { get; set; } = string.Empty;
    }

    private sealed class EmptyInput;
}
