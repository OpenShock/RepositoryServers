@page "/admin/firmware/releases"
@attribute [Authorize(Policy = AuthSchemas.Policies.Admin)]
@using OpenShock.RepositoryServer.RepoServerDb.Models
@inherits AdminPageBase

<PageHeader Title="Releases">
    <Subtitle>
        Releases CI created but has not published. A release whose changelog failed to parse lands in
        <code>editing</code> and cannot be published until the notes are fixed here, which returns it to
        <code>staging</code>.
    </Subtitle>
</PageHeader>

<h2 class="text-lg font-semibold">In flight</h2>

<BbCard Class="w-full overflow-hidden p-0">
    <BbDataGrid TData="FirmwareRelease" Items="_releases" IsLoading="_loading" Striped="true"
                StickyHeader="true">
        <EmptyTemplate>
            <p class="p-4 text-sm text-muted-foreground">Nothing in flight.</p>
        </EmptyTemplate>
        <Columns>
            <BbDataGridPropertyColumn TData="FirmwareRelease" TProp="string" Property="r => r.Version"
                                      Title="Version">
                <CellTemplate>
                    <code>@context.Version</code>
                </CellTemplate>
            </BbDataGridPropertyColumn>
            <BbDataGridPropertyColumn TData="FirmwareRelease" TProp="ReleaseChannel"
                                      Property="r => r.Channel" Title="Channel">
                <CellTemplate>@context.Channel.ToString().ToLowerInvariant()</CellTemplate>
            </BbDataGridPropertyColumn>
            <BbDataGridPropertyColumn TData="FirmwareRelease" TProp="ReleaseStatus" Property="r => r.Status"
                                      Title="Status">
                <CellTemplate>
                    <BbBadge Variant="@(context.Status == ReleaseStatus.Editing
                                          ? BadgeVariant.Destructive : BadgeVariant.Secondary)">
                        @context.Status.ToString().ToLowerInvariant()
                    </BbBadge>
                </CellTemplate>
            </BbDataGridPropertyColumn>
            <BbDataGridPropertyColumn TData="FirmwareRelease" TProp="DateTimeOffset" Property="r => r.CreatedAt"
                                      Title="Created">
                <CellTemplate>
                    <span class="text-muted-foreground">@context.CreatedAt.ToString("u")</span>
                </CellTemplate>
            </BbDataGridPropertyColumn>
            <BbDataGridTemplateColumn TData="FirmwareRelease" Title="Notes" Sortable="false">
                <span class="text-muted-foreground">@NoteCount(context.Id)</span>
            </BbDataGridTemplateColumn>
            <BbDataGridTemplateColumn TData="FirmwareRelease" Title="" Sortable="false" Width="0">
                <div class="flex justify-end">
                    <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.IconSmall" OnClick="() => OpenChangelog(context)" AriaLabel="Fix changelog" title="Fix changelog">
                        <Glyph Name="IconName.FileText"/>
                    </BbButton>
                </div>
            </BbDataGridTemplateColumn>
        </Columns>
    </BbDataGrid>
</BbCard>

<BbDialog @bind-Open="_changelogOpen">
    <BbDialogContent Class="sm:max-w-2xl">
        <BbDialogHeader>
            <BbDialogTitle>Fix changelog for @_changelogVersion</BbDialogTitle>
            <BbDialogDescription>
                Markdown with ### Heading sections. Replaces the staged notes wholesale and puts the
                release back into staging.
            </BbDialogDescription>
        </BbDialogHeader>

        <div class="py-2">
            <BbTextarea @bind-Value="_changelog" Class="min-h-64 font-mono"
                        Placeholder="### Breaking&#10;**Config format** &#8212; Changed to TOML&#10;&#10;### Info&#10;- Fixed WiFi reconnection"/>
        </div>

        <BbDialogFooter>
            <BbButton Variant="ButtonVariant.Outline" OnClick="CloseChangelog">Cancel</BbButton>
            <BbButton OnClick="FixChangelogAsync">Save and return to staging</BbButton>
        </BbDialogFooter>
    </BbDialogContent>
</BbDialog>

<h2 class="text-lg font-semibold">Published versions</h2>
<p class="mb-4 max-w-3xl text-sm text-muted-foreground">
    Removing a version stops it being served. Artifacts stay in storage: they are immutable, and a
    version is normally pulled because it is bad rather than because the bytes must disappear.
</p>

<BbCard Class="w-full overflow-hidden p-0">
    <BbDataGrid TData="FirmwareVersion" Items="_versions" IsLoading="_loading" Striped="true"
                StickyHeader="true">
        <EmptyTemplate>
            <p class="p-4 text-sm text-muted-foreground">Nothing published yet.</p>
        </EmptyTemplate>
        <Columns>
            <BbDataGridPropertyColumn TData="FirmwareVersion" TProp="string" Property="v => v.Version"
                                      Title="Version">
                <CellTemplate>
                    <code>@context.Version</code>
                </CellTemplate>
            </BbDataGridPropertyColumn>
            <BbDataGridPropertyColumn TData="FirmwareVersion" TProp="ReleaseChannel"
                                      Property="v => v.Channel" Title="Channel">
                <CellTemplate>@context.Channel.ToString().ToLowerInvariant()</CellTemplate>
            </BbDataGridPropertyColumn>
            <BbDataGridPropertyColumn TData="FirmwareVersion" TProp="DateTimeOffset" Property="v => v.ReleaseDate"
                                      Title="Released">
                <CellTemplate>
                    <span class="text-muted-foreground">@context.ReleaseDate.ToString("u")</span>
                </CellTemplate>
            </BbDataGridPropertyColumn>
            <BbDataGridTemplateColumn TData="FirmwareVersion" Title="" Sortable="false" Width="0">
                <div class="flex justify-end">
                    <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.IconSmall" Class="text-destructive" OnClick="() => DeleteVersionAsync(context.Version)" AriaLabel="Unpublish" title="Unpublish">
                        <Glyph Name="IconName.Trash"/>
                    </BbButton>
                </div>
            </BbDataGridTemplateColumn>
        </Columns>
    </BbDataGrid>
</BbCard>

@code {
    private FirmwareRelease[] _releases = [];
    private FirmwareVersion[] _versions = [];
    private Dictionary<Guid, int> _noteCounts = new();
    private bool _loading = true;

    private bool _changelogOpen;
    private Guid? _changelogReleaseId;
    private string _changelogVersion = string.Empty;
    private string _changelog = string.Empty;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;

        await using var scope = CreateScope();
        var releases = scope.Get<ReleaseAdminService>();

        _releases = await releases.ListEditableAsync();
        _versions = await releases.ListVersionsAsync();

        // One grouped count rather than a ListStagedNotesAsync per release: the note bodies were
        // fetched only to be thrown away after reading .Length, once per row.
        var releaseIds = _releases.Select(r => r.Id).ToArray();
        _noteCounts = await scope.Get<RepoServerContext>().FirmwareStagedReleaseNotes
            .Where(n => releaseIds.Contains(n.ReleaseId))
            .GroupBy(n => n.ReleaseId)
            .Select(g => new { ReleaseId = g.Key, Count = g.Count() })
            .ToDictionaryAsync(x => x.ReleaseId, x => x.Count);

        _loading = false;
    }

    /// <summary>
    /// A release with no staged notes has no rows to group, so it is absent from the dictionary
    /// rather than present with zero.
    /// </summary>
    private string NoteCount(Guid releaseId) =>
        _noteCounts.GetValueOrDefault(releaseId) is var count && count == 0
            ? "none, needs a changelog"
            : $"{count} section(s)";

    private void OpenChangelog(FirmwareRelease release)
    {
        _changelogReleaseId = release.Id;
        _changelogVersion = release.Version;
        _changelog = string.Empty;
        _changelogOpen = true;
    }

    private void CloseChangelog()
    {
        _changelogOpen = false;
        _changelogReleaseId = null;
        _changelog = string.Empty;
    }

    private async Task FixChangelogAsync()
    {
        if (_changelogReleaseId is not { } releaseId) return;

        await using (var scope = CreateScope())
        {
            var result = await scope.Get<ReleaseAdminService>().FixChangelogAsync(releaseId, _changelog);

            Report(
                result.Match<string?>(
                    _ => null,
                    _ => "That release no longer exists.",
                    notEditable => $"Release is {notEditable.Status.ToString().ToLowerInvariant()}, " +
                                   "which cannot be edited.",
                    ChangelogMessage),
                "Saved. The release is back in staging and can be published.");
        }

        CloseChangelog();
        await LoadAsync();
    }

    private static string ChangelogMessage(InvalidChangelog invalid) => invalid.Error switch
    {
        ChangelogParseError.Empty => "Changelog is empty or whitespace-only.",
        ChangelogParseError.NoHeadings => "Changelog contains no '### Heading' sections.",
        ChangelogParseError.AllSectionsEmpty => "All changelog sections are empty.",
        _ => $"Changelog could not be parsed ({invalid.Error})."
    };

    private async Task DeleteVersionAsync(string version)
    {
        var confirmed = await ConfirmAsync(
            "Unpublish version",
            $"Stop serving {version}? Artifacts stay in storage.",
            confirmText: "Unpublish");

        if (!confirmed) return;

        await using (var scope = CreateScope())
        {
            var result = await scope.Get<ReleaseAdminService>().DeleteVersionAsync(version);

            Report(
                result.Match<string?>(
                    _ => null,
                    _ => "That version no longer exists."),
                $"Unpublished {version}.");
        }

        await LoadAsync();
    }
}
