@*
    Rendered for unmatched routes. Referenced by the router's NotFoundPage, which requires the target to
    be routable, hence the @page directive. Deliberately anonymous: it says nothing about what exists.
*@
@page "/not-found"
@layout AdminLayout

@* Empty-state anatomy, style guide §4.2: medallion, heading, helper line. *@
<div class="flex w-full flex-col items-center justify-center gap-6 py-12 text-center sm:gap-8">
    <div class="flex flex-col items-center gap-3">
        <div class="bg-muted text-muted-foreground flex size-16 items-center justify-center rounded-2xl sm:size-20">
            <svg xmlns="http://www.w3.org/2000/svg" class="size-8 sm:size-10" viewBox="0 0 24 24"
                 fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                 stroke-linejoin="round" aria-hidden="true">
                <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
                <path d="m13.5 8.5-5 5"/><path d="m8.5 8.5 5 5"/>
            </svg>
        </div>
        <h3 class="text-xl font-medium sm:text-2xl">Not found</h3>
        <p class="text-muted-foreground text-base sm:text-lg">No such page.</p>
    </div>
</div>
