@page "/admin"
@attribute [Authorize(Policy = AuthSchemas.Policies.Admin)]
@inherits AdminPageBase

<PageHeader Title="Status"/>

@if (_boardCount == 0 || _chipCount == 0)
{
    <BbAlert Variant="AlertVariant.Danger" Class="mt-4">
        Release init rejects a board it does not know, so CI cannot publish firmware until chips and
        boards exist.
    </BbAlert>
}

<h2 class="text-lg font-semibold">Shared</h2>
<div class="grid w-full grid-cols-1 gap-4 sm:grid-cols-3">
    <StatCard Icon="IconName.Users" Title="Registered publishers" Value="@_publisherCount"
              Note="@(_publishersWithoutScopes > 0 ? $"{_publishersWithoutScopes} cannot publish anything" : null)"
              NoteIsWarning="true" Href="/admin/repositories"/>
    <StatCard Icon="IconName.Bell" Title="Discord webhooks" Value="@_webhookCount"
              Note="@(_disabledWebhooks > 0 ? $"{_disabledWebhooks} disabled" : null)"
              Href="/admin/discord-webhooks"/>
</div>

<h2 class="text-lg font-semibold">Firmware</h2>
<div class="grid w-full grid-cols-1 gap-4 sm:grid-cols-3">
    <StatCard Icon="IconName.Package" Title="Published versions" Value="@_versionCount" Href="/admin/firmware/releases"/>
    <StatCard Icon="IconName.FileText" Title="Awaiting review" Value="@_editingCount"
              Note="@(_editingCount > 0 ? "changelog must be fixed before publish" : null)"
              NoteIsWarning="true" Href="/admin/firmware/releases"/>
    <StatCard Icon="IconName.Rocket" Title="Releases in flight" Value="@_stagingCount" Href="/admin/firmware/releases"/>
    <StatCard Icon="IconName.Board" Title="Boards" Value="@_boardCount"
              Note="@(_discontinuedCount > 0 ? $"{_discontinuedCount} discontinued" : null)"
              Href="/admin/firmware/boards"/>
    <StatCard Icon="IconName.Chip" Title="Chips" Value="@_chipCount" Href="/admin/firmware/chips"/>
    <StatCard Icon="IconName.Warning" Title="Advisories" Value="@_advisoryCount" Href="/admin/firmware/advisories"/>
</div>

<h2 class="text-lg font-semibold">Desktop</h2>
<div class="grid w-full grid-cols-1 gap-4 sm:grid-cols-3">
    <StatCard Icon="IconName.Puzzle" Title="Modules" Value="@_moduleCount"
              Note="@(_unassignedModules > 0 ? $"{_unassignedModules} unassigned, closed to every publisher" : null)"
              NoteIsWarning="true" Href="/admin/desktop/modules"/>
    <StatCard Icon="IconName.Package" Title="Published versions" Value="@_moduleVersionCount" Href="/admin/desktop/modules"/>
</div>

@code {
    private int _publisherCount;
    private int _publishersWithoutScopes;
    private int _webhookCount;
    private int _disabledWebhooks;

    private int _versionCount;
    private int _editingCount;
    private int _stagingCount;
    private int _boardCount;
    private int _discontinuedCount;
    private int _chipCount;
    private int _advisoryCount;

    private int _moduleCount;
    private int _unassignedModules;
    private int _moduleVersionCount;

    protected override async Task OnInitializedAsync()
    {
        await using var scope = CreateScope();
        var db = scope.Get<RepoServerContext>();

        // Each table is counted once, with the qualifying figure taken as a conditional aggregate in
        // the same pass. Counting each table twice meant fifteen sequential round trips on the
        // landing page, and prerendering runs this whole method a second time when the circuit opens.
        var publishers = await db.Repositories
            .GroupBy(_ => 1)
            .Select(g => new { Total = g.Count(), WithoutScopes = g.Count(r => r.Scopes.Length == 0) })
            .FirstOrDefaultAsync();
        _publisherCount = publishers?.Total ?? 0;
        _publishersWithoutScopes = publishers?.WithoutScopes ?? 0;

        var webhooks = await db.DiscordWebhooks
            .GroupBy(_ => 1)
            .Select(g => new { Total = g.Count(), Disabled = g.Count(w => !w.Enabled) })
            .FirstOrDefaultAsync();
        _webhookCount = webhooks?.Total ?? 0;
        _disabledWebhooks = webhooks?.Disabled ?? 0;

        var releases = await db.FirmwareReleases
            .GroupBy(_ => 1)
            .Select(g => new
            {
                Editing = g.Count(r => r.Status == ReleaseStatus.Editing),
                Staging = g.Count(r => r.Status == ReleaseStatus.Staging)
            })
            .FirstOrDefaultAsync();
        _editingCount = releases?.Editing ?? 0;
        _stagingCount = releases?.Staging ?? 0;

        var boards = await db.FirmwareBoards
            .GroupBy(_ => 1)
            .Select(g => new { Total = g.Count(), Discontinued = g.Count(b => b.Discontinued) })
            .FirstOrDefaultAsync();
        _boardCount = boards?.Total ?? 0;
        _discontinuedCount = boards?.Discontinued ?? 0;

        var modules = await db.Modules
            .GroupBy(_ => 1)
            .Select(g => new { Total = g.Count(), Unassigned = g.Count(m => m.RepositoryId == null) })
            .FirstOrDefaultAsync();
        _moduleCount = modules?.Total ?? 0;
        _unassignedModules = modules?.Unassigned ?? 0;

        _versionCount = await db.FirmwareVersions.CountAsync();
        _chipCount = await db.FirmwareChips.CountAsync();
        _advisoryCount = await db.FirmwareAdvisories.CountAsync();
        _moduleVersionCount = await db.Versions.CountAsync();
    }
}
