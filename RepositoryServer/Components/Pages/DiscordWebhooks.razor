@page "/admin/discord-webhooks"
@attribute [Authorize(Policy = AuthSchemas.Policies.Admin)]
@inject DiscordWebhookAdminService Webhooks

<h2>Discord webhooks</h2>

<p class="muted">
    Notification targets, shared by firmware and desktop module publishing. Subscribing per event lets
    maintainer alerts go somewhere other than a public releases channel.
</p>

<StatusAlert Error="@_error" Message="@_message"/>

<table>
    <thead>
    <tr>
        <th>Name</th>
        <th>URL</th>
        <th>Events</th>
        <th>Enabled</th>
        <th></th>
    </tr>
    </thead>
    <tbody>
    @foreach (var webhook in _webhooks)
    {
        <tr>
            <td>@webhook.Name</td>
            @* Masked: the URL is a credential, and anyone who can read it can post to the channel. *@
            <td class="muted"><code>@DiscordWebhookMasking.Mask(webhook.Url)</code></td>
            <td class="muted">@FormatEvents(webhook.Events)</td>
            <td>@(webhook.Enabled ? "yes" : "no")</td>
            <td>
                <EditForm FormName="@($"delete-webhook-{webhook.Id}")" Model="_actionModel"
                          OnValidSubmit="() => DeleteAsync(webhook.Id)">
                    <AntiforgeryToken/>
                    <button type="submit" class="danger">Delete</button>
                </EditForm>
            </td>
        </tr>
    }
    @if (_webhooks.Length == 0)
    {
        <tr>
            <td colspan="5" class="empty">No webhooks. Nothing is notified.</td>
        </tr>
    }
    </tbody>
</table>

<h3>Add or edit</h3>

<EditForm FormName="save-webhook" Model="SaveInput!" OnValidSubmit="SaveAsync" class="stack">
    <AntiforgeryToken/>
    <label>
        Webhook
        <InputSelect @bind-Value="SaveInput!.WebhookId">
            <option value="">new webhook</option>
            @foreach (var webhook in _webhooks)
            {
                <option value="@webhook.Id">@webhook.Name</option>
            }
        </InputSelect>
    </label>
    <label>
        Name
        <InputText @bind-Value="SaveInput!.Name" placeholder="releases channel"/>
    </label>
    <label>
        URL <span class="muted">(leave empty when editing to keep the stored one)</span>
        <InputText @bind-Value="SaveInput!.Url" type="password"
                   placeholder="https://discord.com/api/webhooks/..."/>
    </label>
    <fieldset>
        <legend>Events</legend>
        @foreach (var notificationEvent in Events)
        {
            <label class="inline">
                <input type="checkbox" name="SaveInput.Events" value="@notificationEvent"
                       checked="@(SaveInput!.Events?.Contains(notificationEvent) == true)"/>
                @notificationEvent.ToEventName()
            </label>
        }
    </fieldset>
    <label class="inline">
        <InputCheckbox @bind-Value="SaveInput!.Enabled"/>
        enabled
    </label>
    <button type="submit">Save</button>
</EditForm>

@code {
    private static readonly DiscordNotificationEvent[] Events = Enum.GetValues<DiscordNotificationEvent>();

    private DiscordWebhook[] _webhooks = [];
    private string? _error;
    private string? _message;

    // No initializer: the binder assigns this on every post and would overwrite one with null (BL0008).
    [SupplyParameterFromForm(FormName = "save-webhook")]
    private WebhookInput? SaveInput { get; set; }

    /// <summary>Satisfies EditForm on the delete buttons, which carry an id and no fields.</summary>
    private readonly EmptyInput _actionModel = new();

    protected override async Task OnInitializedAsync()
    {
        SaveInput ??= new WebhookInput();
        await LoadAsync();
    }

    private async Task LoadAsync() => _webhooks = await Webhooks.ListAsync();

    private static string FormatEvents(DiscordNotificationEvent[] events) =>
        events.Length == 0 ? "none" : string.Join(", ", events.Select(e => e.ToEventName()));

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(SaveInput!.Name))
        {
            Report("Name is required.", string.Empty);
            return;
        }

        var events = SaveInput.Events?.ToArray() ?? [];
        var url = string.IsNullOrWhiteSpace(SaveInput.Url) ? null : SaveInput.Url.Trim();

        if (SaveInput.WebhookId is { } webhookId)
        {
            var result = await Webhooks.UpdateAsync(webhookId, SaveInput.Name, url, events, SaveInput.Enabled);

            Report(
                result.Match<string?>(
                    _ => null,
                    _ => "That webhook no longer exists."),
                "Saved.");
        }
        else
        {
            if (url is null)
            {
                Report("A URL is required for a new webhook.", string.Empty);
                return;
            }

            await Webhooks.CreateAsync(SaveInput.Name, url, events, SaveInput.Enabled);
            Report(null, "Created.");
        }

        SaveInput = new WebhookInput();
        await LoadAsync();
    }

    private async Task DeleteAsync(Guid webhookId)
    {
        var result = await Webhooks.DeleteAsync(webhookId);

        Report(
            result.Match<string?>(
                _ => null,
                _ => "That webhook no longer exists."),
            "Deleted.");

        await LoadAsync();
    }

    private void Report(string? error, string success)
    {
        _error = error;
        _message = error is null ? success : null;
    }

    private sealed class WebhookInput
    {
        public Guid? WebhookId { get; set; }
        public string Name { get; set; } = string.Empty;
        public string? Url { get; set; }
        public List<DiscordNotificationEvent>? Events { get; set; }
        public bool Enabled { get; set; } = true;
    }

    private sealed class EmptyInput;
}
