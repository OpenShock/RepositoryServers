@page "/admin/discord-webhooks"
@attribute [Authorize(Policy = AuthSchemas.Policies.Admin)]
@inherits AdminPageBase

<PageHeader Title="Discord webhooks">
    <Subtitle>
        Notification targets, shared by firmware and desktop module publishing. Subscribing per event lets
        maintainer alerts go somewhere other than a public releases channel.
    </Subtitle>
    <Actions>
        <BbButton OnClick="OpenCreate">Add webhook</BbButton>
    </Actions>
</PageHeader>

<BbCard Class="w-full overflow-hidden p-0">
        <BbDataGrid TData="DiscordWebhook" Items="_webhooks" IsLoading="_loading" Striped="true"
                    StickyHeader="true">
            <EmptyTemplate>
                <BbAlert Variant="AlertVariant.Info" Class="m-2">No webhooks. Nothing is notified.</BbAlert>
            </EmptyTemplate>
            <Columns>
                <BbDataGridPropertyColumn TData="DiscordWebhook" TProp="string" Property="w => w.Name"
                                          Title="Name"/>
                @* Masked: the URL is a credential, and anyone who can read it can post to the channel. *@
                <BbDataGridTemplateColumn TData="DiscordWebhook" Title="URL" Sortable="false">
                    <code class="text-muted-foreground">@DiscordWebhookMasking.Mask(context.Url)</code>
                </BbDataGridTemplateColumn>
                <BbDataGridTemplateColumn TData="DiscordWebhook" Title="Events" Sortable="false">
                    @if (context.Events.Length == 0)
                    {
                        <span class="text-sm text-muted-foreground">none</span>
                    }
                    else
                    {
                        <div class="flex flex-wrap gap-1">
                            @foreach (var notificationEvent in context.Events)
                            {
                                <BbBadge Variant="BadgeVariant.Outline">@notificationEvent.ToEventName()</BbBadge>
                            }
                        </div>
                    }
                </BbDataGridTemplateColumn>
                <BbDataGridPropertyColumn TData="DiscordWebhook" TProp="bool" Property="w => w.Enabled"
                                          Title="Enabled">
                    <CellTemplate>
                        <BbBadge Variant="@(context.Enabled ? BadgeVariant.Default : BadgeVariant.Secondary)">
                            @(context.Enabled ? "yes" : "no")
                        </BbBadge>
                    </CellTemplate>
                </BbDataGridPropertyColumn>
                <BbDataGridTemplateColumn TData="DiscordWebhook" Title="" Sortable="false" Width="0">
                    <div class="flex justify-end gap-1">
                        <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.IconSmall" OnClick="() => OpenEdit(context)" AriaLabel="Edit" title="Edit">
                        <Glyph Name="IconName.Pencil"/>
                    </BbButton>
                        <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.IconSmall" Class="text-destructive" OnClick="() => DeleteAsync(context)" AriaLabel="Delete" title="Delete">
                        <Glyph Name="IconName.Trash"/>
                    </BbButton>
                    </div>
                </BbDataGridTemplateColumn>
            </Columns>
    </BbDataGrid>
</BbCard>

<BbDialog @bind-Open="_formOpen">
    <BbDialogContent Class="sm:max-w-md">
        <BbDialogHeader>
            <BbDialogTitle>@(_editingId is null ? "Add a webhook" : $"Edit {_name}")</BbDialogTitle>
            <BbDialogDescription>
                Subscribing per event lets maintainer alerts go somewhere other than a public
                releases channel.
            </BbDialogDescription>
        </BbDialogHeader>

        <div class="flex flex-col gap-4 py-2">
            <div class="flex flex-col gap-2">
                <BbLabel For="name">Name</BbLabel>
                <BbInput Id="name" @bind-Value="_name" Placeholder="releases channel"/>
            </div>
            <div class="flex flex-col gap-2">
                <BbLabel For="url">URL</BbLabel>
                <BbInput Id="url" @bind-Value="_url" Type="InputType.Password"
                         Placeholder="https://discord.com/api/webhooks/..."/>
                @if (_editingId is not null)
                {
                    <p class="text-muted-foreground text-xs">Leave empty to keep the stored one.</p>
                }
            </div>
            <div class="flex flex-col gap-2">
                <BbLabel>Events</BbLabel>
                @foreach (var notificationEvent in Events)
                {
                    var current = notificationEvent;
                    <div class="flex items-center gap-2">
                        <BbCheckbox Id="@($"event-{current}")" Checked="_events.Contains(current)"
                                    CheckedChanged="@(checkedNow => ToggleEvent(current, checkedNow))"/>
                        <BbLabel For="@($"event-{current}")">@current.ToEventName()</BbLabel>
                    </div>
                }
            </div>
            <div class="flex items-center gap-2">
                <BbSwitch Id="enabled" @bind-Checked="_enabled"/>
                <BbLabel For="enabled">Enabled</BbLabel>
            </div>
        </div>

        <BbDialogFooter>
            <BbButton Variant="ButtonVariant.Outline" OnClick="() => _formOpen = false">Cancel</BbButton>
            <BbButton OnClick="SaveAsync">Save</BbButton>
        </BbDialogFooter>
    </BbDialogContent>
</BbDialog>

@code {
    private static readonly DiscordNotificationEvent[] Events = Enum.GetValues<DiscordNotificationEvent>();

    private DiscordWebhook[] _webhooks = [];
    private bool _loading = true;

    private bool _formOpen;
    private Guid? _editingId;
    private string _name = string.Empty;
    private string? _url;
    private readonly HashSet<DiscordNotificationEvent> _events = [];
    private bool _enabled = true;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        await using var scope = CreateScope();
        _webhooks = await scope.Get<DiscordWebhookAdminService>().ListAsync();
        _loading = false;
    }

    private void ToggleEvent(DiscordNotificationEvent notificationEvent, bool selected)
    {
        if (selected) _events.Add(notificationEvent);
        else _events.Remove(notificationEvent);
    }

    private void OpenCreate()
    {
        ResetForm();
        _formOpen = true;
    }

    private void OpenEdit(DiscordWebhook webhook)
    {
        _formOpen = true;
        _editingId = webhook.Id;
        _name = webhook.Name;
        // Never populated from the stored value: it is a credential and the UI only ever shows it masked.
        _url = null;
        _events.Clear();
        foreach (var notificationEvent in webhook.Events) _events.Add(notificationEvent);
        _enabled = webhook.Enabled;
    }

    private void ResetForm()
    {
        _editingId = null;
        _name = string.Empty;
        _url = null;
        _events.Clear();
        _enabled = true;
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_name))
        {
            ReportError("Name is required.");
            return;
        }

        var url = string.IsNullOrWhiteSpace(_url) ? null : _url.Trim();
        var events = _events.ToArray();

        if (_editingId is null && url is null)
        {
            ReportError("A URL is required for a new webhook.");
            return;
        }

        await using (var scope = CreateScope())
        {
            var webhooks = scope.Get<DiscordWebhookAdminService>();

            if (_editingId is { } webhookId)
            {
                var result = await webhooks.UpdateAsync(webhookId, _name, url, events, _enabled);

                Report(
                    result.Match<string?>(
                        _ => null,
                        _ => "That webhook no longer exists."),
                    "Saved.");
            }
            else
            {
                await webhooks.CreateAsync(_name, url!, events, _enabled);
                Report(null, "Created.");
            }
        }

        _formOpen = false;
        ResetForm();
        await LoadAsync();
    }

    private async Task DeleteAsync(DiscordWebhook webhook)
    {
        if (!await ConfirmAsync("Delete webhook", $"Delete \"{webhook.Name}\"?")) return;

        await using (var scope = CreateScope())
        {
            var result = await scope.Get<DiscordWebhookAdminService>().DeleteAsync(webhook.Id);

            Report(
                result.Match<string?>(
                    _ => null,
                    _ => "That webhook no longer exists."),
                "Deleted.");
        }

        if (_editingId == webhook.Id) ResetForm();
        await LoadAsync();
    }
}
