@page "/admin/firmware/chips"
@attribute [Authorize(Policy = AuthSchemas.Policies.Admin)]
@inject CatalogAdminService Catalog

<h2>Chips</h2>

<p class="muted">
    Names must match esptool-js chip identifiers exactly, since the web flashtool passes them straight
    through to the flasher.
</p>

@* Both are string parameters, so they need the @ prefix; without it Razor passes the literal text. *@
<StatusAlert Error="@_error" Message="@_message"/>

<table>
    <thead>
    <tr>
        <th>Name</th>
        <th>Architecture</th>
        <th>USB devices</th>
        <th></th>
    </tr>
    </thead>
    <tbody>
    @foreach (var chip in _chips)
    {
        <tr>
            <td>
                <EditForm FormName="@($"edit-chip-{chip.Id}")" Model="EditInput!"
                          OnValidSubmit="() => UpdateAsync(chip.Id)" class="row-form">
                    <AntiforgeryToken/>
                    <InputText @bind-Value="EditInput!.Name" placeholder="@chip.Name" size="24"/>
                    <InputSelect @bind-Value="EditInput!.Architecture">
                        <option value="">unspecified</option>
                        @foreach (var architecture in Architectures)
                        {
                            <option value="@architecture">@architecture.ToString().ToLowerInvariant()</option>
                        }
                    </InputSelect>
                    <button type="submit">Save</button>
                </EditForm>
            </td>
            <td>@(chip.Architecture?.ToString().ToLowerInvariant() ?? "unspecified")</td>
            <td class="muted">@AttachedDeviceNames(chip.Id)</td>
            <td>
                <EditForm FormName="@($"delete-chip-{chip.Id}")" Model="_deleteModel"
                          OnValidSubmit="() => DeleteAsync(chip.Id)">
                    <AntiforgeryToken/>
                    <button type="submit" class="danger">Delete</button>
                </EditForm>
            </td>
        </tr>
    }
    @if (_chips.Length == 0)
    {
        <tr>
            <td colspan="4" class="empty">No chips.</td>
        </tr>
    }
    </tbody>
</table>

<h3>Add a chip</h3>

<EditForm FormName="create-chip" Model="CreateInput!" OnValidSubmit="CreateAsync" class="stack">
    <AntiforgeryToken/>
    <label>
        Name
        <InputText @bind-Value="CreateInput!.Name" placeholder="ESP32-S3"/>
    </label>
    <label>
        Architecture
        <InputSelect @bind-Value="CreateInput!.Architecture">
            <option value="">unspecified</option>
            @foreach (var architecture in Architectures)
            {
                <option value="@architecture">@architecture.ToString().ToLowerInvariant()</option>
            }
        </InputSelect>
    </label>
    <button type="submit">Create</button>
</EditForm>

<h3>USB devices</h3>

<p class="muted">Native USB modes a chip exposes, used to recognise a board in the flashtool.</p>

<EditForm FormName="attach-chip-usb" Model="AttachInput!" OnValidSubmit="AttachAsync" class="stack">
    <AntiforgeryToken/>
    <label>
        Chip
        <InputSelect @bind-Value="AttachInput!.ChipId">
            <option value="">select</option>
            @foreach (var chip in _chips)
            {
                <option value="@chip.Id">@chip.Name</option>
            }
        </InputSelect>
    </label>
    <label>
        Device
        <InputSelect @bind-Value="AttachInput!.UsbDeviceId">
            <option value="">select</option>
            @foreach (var device in _usbDevices)
            {
                <option value="@device.Id">@device.Name (@FormatId(device.Vid):@FormatId(device.Pid))</option>
            }
        </InputSelect>
    </label>
    <button type="submit">Attach</button>
    <button type="submit" formaction="" name="detach" value="true" @onclick="() => _detach = true">Detach</button>
</EditForm>

@code {
    private static readonly FirmwareChipArchitecture[] Architectures = Enum.GetValues<FirmwareChipArchitecture>();

    private FirmwareChip[] _chips = [];
    private UsbDevice[] _usbDevices = [];
    private FirmwareChipUsbDevice[] _attachments = [];
    private string? _error;
    private string? _message;
    private bool _detach;

    // Form-bound properties must not have initializers: the binder assigns them on every post, and an
    // initializer would be overwritten with null when a post carries no value for them (BL0008).
    [SupplyParameterFromForm(FormName = "create-chip")]
    private ChipInput? CreateInput { get; set; }

    [SupplyParameterFromForm(FormName = "edit-chip")]
    private ChipInput? EditInput { get; set; }

    [SupplyParameterFromForm(FormName = "attach-chip-usb")]
    private AttachInputModel? AttachInput { get; set; }

    /// <summary>Satisfies EditForm on the delete buttons, which submit an id in their name and no fields.</summary>
    private readonly EmptyInput _deleteModel = new();

    protected override async Task OnInitializedAsync()
    {
        CreateInput ??= new ChipInput();
        EditInput ??= new ChipInput();
        AttachInput ??= new AttachInputModel();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _chips = await Catalog.ListChipsAsync();
        _usbDevices = await Catalog.ListUsbDevicesAsync();
        _attachments = await Catalog.ListChipUsbDevicesAsync();
    }

    private string AttachedDeviceNames(Guid chipId)
    {
        var names = _attachments
            .Where(a => a.ChipId == chipId)
            .Select(a => _usbDevices.FirstOrDefault(d => d.Id == a.UsbDeviceId)?.Name)
            .Where(n => n is not null)
            .ToArray();

        return names.Length == 0 ? "none" : string.Join(", ", names);
    }

    private static string FormatId(int value) => $"0x{value:X4}";

    private async Task CreateAsync()
    {
        var result = await Catalog.CreateChipAsync(CreateInput!.Name, CreateInput.Architecture);

        Report(
            result.Match<string?>(
                _ => null,
                conflict => $"A chip named \"{conflict.Name}\" already exists."),
            $"Created {CreateInput.Name}.");

        CreateInput = new ChipInput();
        await LoadAsync();
    }

    private async Task UpdateAsync(Guid chipId)
    {
        var name = string.IsNullOrWhiteSpace(EditInput!.Name)
            ? _chips.FirstOrDefault(c => c.Id == chipId)?.Name
            : EditInput.Name;

        if (name is null) return;

        var result = await Catalog.UpdateChipAsync(chipId, name, EditInput.Architecture);

        Report(
            result.Match<string?>(
                _ => null,
                _ => "That chip no longer exists.",
                conflict => $"A chip named \"{conflict.Name}\" already exists."),
            "Saved.");

        EditInput = new ChipInput();
        await LoadAsync();
    }

    private async Task DeleteAsync(Guid chipId)
    {
        var result = await Catalog.DeleteChipAsync(chipId);

        Report(
            result.Match<string?>(
                _ => null,
                _ => "That chip no longer exists.",
                inUse => $"Cannot delete: still referenced by {inUse.ReferencedBy}."),
            "Deleted.");

        await LoadAsync();
    }

    private async Task AttachAsync()
    {
        if (AttachInput!.ChipId is not { } chipId || AttachInput.UsbDeviceId is not { } deviceId) return;

        if (_detach)
        {
            await Catalog.DetachUsbDeviceFromChipAsync(chipId, deviceId);
            Report(null, "Detached.");
        }
        else
        {
            var result = await Catalog.AttachUsbDeviceToChipAsync(chipId, deviceId);
            Report(
                result.Match<string?>(
                    _ => null,
                    missing => $"No such {missing.Reference}."),
                "Attached.");
        }

        _detach = false;
        await LoadAsync();
    }

    private void Report(string? error, string success)
    {
        _error = error;
        _message = error is null ? success : null;
    }

    private sealed class ChipInput
    {
        public string Name { get; set; } = string.Empty;
        public FirmwareChipArchitecture? Architecture { get; set; }
    }

    private sealed class EmptyInput;

    private sealed class AttachInputModel
    {
        public Guid? ChipId { get; set; }
        public Guid? UsbDeviceId { get; set; }
    }
}
