@page "/admin/firmware/chips"
@attribute [Authorize(Policy = AuthSchemas.Policies.Admin)]
@inherits AdminPageBase

<PageHeader Title="Chips">
    <Subtitle>
        Names must match esptool-js chip identifiers exactly, since the web flashtool passes them straight
        through to the flasher.
    </Subtitle>
    <Actions>
        <BbButton OnClick="OpenCreate">Add chip</BbButton>
    </Actions>
</PageHeader>

@*
    The table owns the page and the forms live in dialogs, rather than a permanent side panel. A side
    panel costs half the width on every visit for something used occasionally, and it needs its own
    "which record am I editing?" affordance, which a dialog title answers by itself.
*@
<BbCard Class="w-full overflow-hidden p-0">
    <BbDataGrid TData="FirmwareChip" Items="_chips" IsLoading="_loading" Striped="true"
                StickyHeader="true">
        <EmptyTemplate>
            <div class="flex flex-col items-center gap-3 py-12 text-center">
                <p class="text-muted-foreground">No chips yet.</p>
                <BbButton Variant="ButtonVariant.Outline" OnClick="OpenCreate">Add the first chip</BbButton>
            </div>
        </EmptyTemplate>
        <Columns>
            <BbDataGridPropertyColumn TData="FirmwareChip" TProp="string" Property="c => c.Name" Title="Name"/>
            <BbDataGridTemplateColumn TData="FirmwareChip" Title="Architecture">
                @(context.Architecture?.ToString().ToLowerInvariant() ?? "unspecified")
            </BbDataGridTemplateColumn>
            <BbDataGridTemplateColumn TData="FirmwareChip" Title="USB devices" Sortable="false">
                <span class="text-muted-foreground">@AttachedDeviceNames(context.Id)</span>
            </BbDataGridTemplateColumn>
            @* Action column collapses to its content, per style guide §3.4. *@
            <BbDataGridTemplateColumn TData="FirmwareChip" Title="" Sortable="false" Width="0">
                <div class="flex justify-end gap-1">
                    <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.IconSmall" OnClick="() => OpenEdit(context)" AriaLabel="Edit" title="Edit">
                        <Glyph Name="IconName.Pencil"/>
                    </BbButton>
                    <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.IconSmall" OnClick="() => OpenAttach(context)" AriaLabel="USB devices" title="USB devices">
                        <Glyph Name="IconName.Usb"/>
                    </BbButton>
                    <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.IconSmall" Class="text-destructive" OnClick="() => DeleteAsync(context)" AriaLabel="Delete" title="Delete">
                        <Glyph Name="IconName.Trash"/>
                    </BbButton>
                </div>
            </BbDataGridTemplateColumn>
        </Columns>
    </BbDataGrid>
</BbCard>

<BbDialog @bind-Open="_formOpen">
    <BbDialogContent Class="sm:max-w-md">
        <BbDialogHeader>
            <BbDialogTitle>@(_editingChipId is null ? "Add a chip" : $"Edit {_name}")</BbDialogTitle>
            <BbDialogDescription>
                The name is passed straight to esptool-js, so it has to match its identifier exactly.
            </BbDialogDescription>
        </BbDialogHeader>

        <div class="flex flex-col gap-4 py-2">
            <div class="flex flex-col gap-2">
                <BbLabel For="chip-name">Name</BbLabel>
                <BbInput Id="chip-name" @bind-Value="_name" Placeholder="ESP32-S3"/>
            </div>
            <div class="flex flex-col gap-2">
                <BbLabel>Architecture</BbLabel>
                <BbSelect TValue="FirmwareChipArchitecture?" @bind-Value="_architecture">
                    <BbSelectTrigger TValue="FirmwareChipArchitecture?">
                        <BbSelectValue Placeholder="unspecified"/>
                    </BbSelectTrigger>
                    <BbSelectContent TValue="FirmwareChipArchitecture?">
                        @foreach (var architecture in Architectures)
                        {
                            <BbSelectItem TValue="FirmwareChipArchitecture?" Value="@architecture"
                                          Text="@architecture.ToString().ToLowerInvariant()"/>
                        }
                    </BbSelectContent>
                </BbSelect>
            </div>
        </div>

        <BbDialogFooter>
            <BbButton Variant="ButtonVariant.Outline" OnClick="() => _formOpen = false">Cancel</BbButton>
            <BbButton OnClick="SaveAsync">@(_editingChipId is null ? "Create" : "Save")</BbButton>
        </BbDialogFooter>
    </BbDialogContent>
</BbDialog>

<BbDialog @bind-Open="_attachOpen">
    <BbDialogContent Class="sm:max-w-md">
        <BbDialogHeader>
            <BbDialogTitle>USB devices for @_attachChipName</BbDialogTitle>
            <BbDialogDescription>
                Native USB modes this chip exposes, used to recognise a board in the flashtool.
            </BbDialogDescription>
        </BbDialogHeader>

        <div class="flex flex-col gap-4 py-2">
            <div class="flex flex-col gap-2">
                <BbLabel>Currently attached</BbLabel>
                <p class="text-muted-foreground text-sm">
                    @(_attachChipId is { } id ? AttachedDeviceNames(id) : "none")
                </p>
            </div>
            <div class="flex flex-col gap-2">
                <BbLabel>Device</BbLabel>
                <BbSelect TValue="Guid?" @bind-Value="_attachDeviceId">
                    <BbSelectTrigger TValue="Guid?">
                        <BbSelectValue Placeholder="select a device"/>
                    </BbSelectTrigger>
                    <BbSelectContent TValue="Guid?">
                        @foreach (var device in _usbDevices)
                        {
                            <BbSelectItem TValue="Guid?" Value="@device.Id"
                                          Text="@($"{device.Name} ({Hex(device.Vid)}:{Hex(device.Pid)})")"/>
                        }
                    </BbSelectContent>
                </BbSelect>
            </div>
        </div>

        <BbDialogFooter>
            <BbButton Variant="ButtonVariant.Outline"
                      OnClick="() => ApplyAttachmentAsync(detach: true)">Detach</BbButton>
            <BbButton OnClick="() => ApplyAttachmentAsync(detach: false)">Attach</BbButton>
        </BbDialogFooter>
    </BbDialogContent>
</BbDialog>

@code {
    private static readonly FirmwareChipArchitecture[] Architectures = Enum.GetValues<FirmwareChipArchitecture>();

    private FirmwareChip[] _chips = [];
    private UsbDevice[] _usbDevices = [];
    private FirmwareChipUsbDevice[] _attachments = [];
    private bool _loading = true;

    private bool _formOpen;
    private Guid? _editingChipId;
    private string _name = string.Empty;
    private FirmwareChipArchitecture? _architecture;

    private bool _attachOpen;
    private Guid? _attachChipId;
    private string _attachChipName = string.Empty;
    private Guid? _attachDeviceId;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;

        await using var scope = CreateScope();
        var catalog = scope.Get<CatalogAdminService>();

        _chips = await catalog.ListChipsAsync();
        _usbDevices = await catalog.ListUsbDevicesAsync();
        _attachments = await catalog.ListChipUsbDevicesAsync();

        _loading = false;
    }

    private static string Hex(int value) => $"0x{value:X4}";

    private string AttachedDeviceNames(Guid chipId)
    {
        var names = _attachments
            .Where(a => a.ChipId == chipId)
            .Select(a => _usbDevices.FirstOrDefault(d => d.Id == a.UsbDeviceId)?.Name)
            .Where(n => n is not null)
            .ToArray();

        return names.Length == 0 ? "none" : string.Join(", ", names);
    }

    private void OpenCreate()
    {
        _editingChipId = null;
        _name = string.Empty;
        _architecture = null;
        _formOpen = true;
    }

    private void OpenEdit(FirmwareChip chip)
    {
        _editingChipId = chip.Id;
        _name = chip.Name;
        _architecture = chip.Architecture;
        _formOpen = true;
    }

    private void OpenAttach(FirmwareChip chip)
    {
        _attachChipId = chip.Id;
        _attachChipName = chip.Name;
        _attachDeviceId = null;
        _attachOpen = true;
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_name))
        {
            ReportError("Name is required.");
            return;
        }

        await using (var scope = CreateScope())
        {
            var catalog = scope.Get<CatalogAdminService>();

            if (_editingChipId is { } chipId)
            {
                var result = await catalog.UpdateChipAsync(chipId, _name.Trim(), _architecture);

                Report(
                    result.Match<string?>(
                        _ => null,
                        _ => "That chip no longer exists.",
                        conflict => $"A chip named \"{conflict.Name}\" already exists."),
                    "Saved.");
            }
            else
            {
                var result = await catalog.CreateChipAsync(_name.Trim(), _architecture);

                Report(
                    result.Match<string?>(
                        _ => null,
                        conflict => $"A chip named \"{conflict.Name}\" already exists."),
                    $"Created {_name}.");
            }
        }

        _formOpen = false;
        await LoadAsync();
    }

    private async Task DeleteAsync(FirmwareChip chip)
    {
        if (!await ConfirmAsync("Delete chip", $"Delete {chip.Name}?")) return;

        await using (var scope = CreateScope())
        {
            var result = await scope.Get<CatalogAdminService>().DeleteChipAsync(chip.Id);

            Report(
                result.Match<string?>(
                    _ => null,
                    _ => "That chip no longer exists.",
                    inUse => $"Cannot delete: still referenced by {inUse.ReferencedBy}."),
                "Deleted.");
        }

        await LoadAsync();
    }

    private async Task ApplyAttachmentAsync(bool detach)
    {
        if (_attachChipId is not { } chipId || _attachDeviceId is not { } deviceId)
        {
            ReportError("Pick a device.");
            return;
        }

        await using (var scope = CreateScope())
        {
            var catalog = scope.Get<CatalogAdminService>();

            if (detach)
            {
                await catalog.DetachUsbDeviceFromChipAsync(chipId, deviceId);
                Report(null, "Detached.");
            }
            else
            {
                var result = await catalog.AttachUsbDeviceToChipAsync(chipId, deviceId);
                Report(
                    result.Match<string?>(
                        _ => null,
                        missing => $"No such {missing.Reference}."),
                    "Attached.");
            }
        }

        _attachDeviceId = null;
        await LoadAsync();
    }
}
