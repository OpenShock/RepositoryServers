@page "/admin/firmware/usb-devices"
@attribute [Authorize(Policy = AuthSchemas.Policies.Admin)]
@inject CatalogAdminService Catalog

<h2>USB devices</h2>

<p class="muted">
    Recognition catalog. A VID and PID pair identifies a USB interface, either a chip's native USB or a
    board's serial converter. Saving an existing pair renames it rather than adding a second row.
</p>

<StatusAlert Error="@_error" Message="@_message"/>

<table>
    <thead>
    <tr>
        <th>VID</th>
        <th>PID</th>
        <th>Name</th>
        <th></th>
    </tr>
    </thead>
    <tbody>
    @foreach (var device in _devices)
    {
        <tr>
            <td><code>@Hex(device.Vid)</code></td>
            <td><code>@Hex(device.Pid)</code></td>
            <td>@device.Name</td>
            <td>
                <EditForm FormName="@($"delete-usb-device-{device.Id}")" Model="_deleteModel"
                          OnValidSubmit="() => DeleteAsync(device.Id)">
                    <AntiforgeryToken/>
                    <button type="submit" class="danger">Delete</button>
                </EditForm>
            </td>
        </tr>
    }
    @if (_devices.Length == 0)
    {
        <tr>
            <td colspan="4" class="empty">No USB devices.</td>
        </tr>
    }
    </tbody>
</table>

<h3>Add or rename</h3>

<EditForm FormName="upsert-usb-device" Model="UpsertInput!" OnValidSubmit="UpsertAsync" class="stack">
    <AntiforgeryToken/>
    <label>
        VID
        <InputText @bind-Value="UpsertInput!.Vid" placeholder="0x1A86"/>
    </label>
    <label>
        PID
        <InputText @bind-Value="UpsertInput!.Pid" placeholder="0x7522"/>
    </label>
    <label>
        Name
        <InputText @bind-Value="UpsertInput!.Name" placeholder="CH9102"/>
    </label>
    <button type="submit">Save</button>
</EditForm>

@code {
    private UsbDevice[] _devices = [];
    private string? _error;
    private string? _message;

    // No initializer: the binder assigns this on every post and would overwrite one with null (BL0008).
    [SupplyParameterFromForm]
    private UsbDeviceInput? UpsertInput { get; set; }

    /// <summary>Satisfies EditForm on the delete buttons, which carry an id and no fields.</summary>
    private readonly EmptyInput _deleteModel = new();

    protected override async Task OnInitializedAsync()
    {
        UpsertInput ??= new UsbDeviceInput();
        await LoadAsync();
    }

    private async Task LoadAsync() => _devices = await Catalog.ListUsbDevicesAsync();

    private static string Hex(int value) => $"0x{value:X4}";

    private async Task UpsertAsync()
    {
        if (!UsbIdentifier.TryParse(UpsertInput!.Vid, out var vid) ||
            !UsbIdentifier.TryParse(UpsertInput.Pid, out var pid))
        {
            Report("VID and PID must be numbers, in hex (0x1A86) or decimal.", string.Empty);
            return;
        }

        await Catalog.UpsertUsbDeviceAsync(vid, pid, UpsertInput.Name);
        Report(null, "Saved.");
        UpsertInput = new UsbDeviceInput();
        await LoadAsync();
    }

    private async Task DeleteAsync(Guid id)
    {
        var result = await Catalog.DeleteUsbDeviceAsync(id);

        Report(
            result.Match<string?>(
                _ => null,
                _ => "That device no longer exists.",
                inUse => $"Cannot delete: still linked to {inUse.ReferencedBy}."),
            "Deleted.");
        await LoadAsync();
    }

    private void Report(string? error, string success)
    {
        _error = error;
        _message = error is null ? success : null;
    }

    private sealed class UsbDeviceInput
    {
        public string Vid { get; set; } = string.Empty;
        public string Pid { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
    }

    private sealed class EmptyInput;
}
