// OpenShock's catalog, for /admin/import.
//
// Comments and trailing commas are accepted — the importer parses with
// JsonCommentHandling.Skip — so the sources for the USB ids can sit next to them.
//
// USB ids below are Espressif's documented values, not inferred:
//   0x303A        Espressif Systems vendor id
//   0x303A:0x0002 ESP32-S2 in USB-OTG mode
//   0x303A:0x1001 USB-Serial/JTAG unit, shared by the chips that have that peripheral
// https://docs.espressif.com/projects/esptool/en/latest/esp32/esptool/advanced-options.html
{
  // Names must match esptool-js chip identifiers exactly; the web flashtool passes what it
  // reads off a connected device straight through.
  //
  // usbDevices is what each chip exposes natively, which is a property of the silicon:
  //   ESP32     no native USB at all — always reached through a bridge on the board
  //   ESP32-S2  USB-OTG, ROM CDC (0x0002). No USB-Serial/JTAG peripheral.
  //   ESP32-S3  USB Serial/JTAG Controller (0x1001)
  //   ESP32-C3  USB Serial/JTAG Controller (0x1001)
  "chips": [
    { "name": "ESP32", "architecture": "xtensa" },
    { "name": "ESP32-S2", "architecture": "xtensa", "usbDevices": ["303A:0002"] },
    { "name": "ESP32-S3", "architecture": "xtensa", "usbDevices": ["303A:1001"] },
    { "name": "ESP32-C3", "architecture": "riscv", "usbDevices": ["303A:1001"] }
  ],

  "usbDevices": [
    { "vid": "303A", "pid": "0002", "name": "Espressif ESP32-S2 (USB-OTG)" },
    { "vid": "303A", "pid": "1001", "name": "Espressif USB-Serial/JTAG" }
  ],

  // Names are the boards/<name>.defaults basenames in the Firmware repository, which is what a
  // hub reports as its own board. requiredArtifacts defaults to app + staticfs, what an OTA needs.
  //
  // Board-level usbDevices is what THIS board enumerates as, which depends on whether a
  // USB-to-serial bridge is fitted — a per-revision hardware fact, not something the chip
  // implies. It is set only for the two boards whose schematics are in the Hardware repo:
  // both are ESP32-S3-WROOM-1 with USB D+/D- wired straight to the module and no bridge IC,
  // so both enumerate as the S3's USB-Serial/JTAG.
  //
  // The rest are left unset on purpose. Guessing a bridge would put wrong data in front of the
  // flashtool, and the chip-level entries above already cover the native-USB case. Fill them in
  // from the actual hardware.
  "boards": [
    { "name": "DFRobot-Firebeetle2-ESP32E", "chip": "ESP32" },
    { "name": "NodeMCU-32S", "chip": "ESP32" },
    { "name": "Pishock-2023", "chip": "ESP32" },
    { "name": "Pishock-Lite-2021", "chip": "ESP32" },
    { "name": "Wemos-D1-Mini-ESP32", "chip": "ESP32" },

    { "name": "Wemos-Lolin-S2-Mini", "chip": "ESP32-S2" },

    { "name": "OpenShock-Core-V1", "chip": "ESP32-S3", "usbDevices": ["303A:1001"] },
    { "name": "OpenShock-Core-V2", "chip": "ESP32-S3", "usbDevices": ["303A:1001"] },
    { "name": "Seeed-Xiao-ESP32S3", "chip": "ESP32-S3" },
    { "name": "Waveshare_esp32_s3_zero", "chip": "ESP32-S3" },
    { "name": "Wemos-Lolin-S3", "chip": "ESP32-S3" },
    { "name": "Wemos-Lolin-S3-Mini", "chip": "ESP32-S3" },

    { "name": "Seeed-Xiao-ESP32C3", "chip": "ESP32-C3" }
  ],

  // Registration is the authorization decision for publishing, not the OIDC token. Scopes are
  // replaced on import, so this is the whole grant for each repository listed.
  "repositories": [
    { "owner": "OpenShock", "repo": "Firmware", "scopes": ["publish_firmware"] },
    { "owner": "OpenShock", "repo": "Desktop-Modules", "scopes": ["publish_modules"] }
  ],

  // Which serial ports the flashtool offers. Vendor-wide where the product id varies across
  // parts in the family, specific where one part is the one that shows up on ESP32 boards.
  "usbSerialFilters": [
    { "vid": "303A", "description": "Espressif native USB (any product)" },
    { "vid": "10C4", "pid": "EA60", "description": "Silicon Labs CP210x" },
    { "vid": "0403", "pid": "6001", "description": "FTDI FT232R" },
    { "vid": "1A86", "description": "WCH CH340 / CH9102 (any product)" }
  ],

  "modules": [
    {
      "id": "forzashock",
      "name": "ForzaShock",
      "description": "Forza Horizon integration.",
      "sourceUrl": "https://github.com/OpenShock/Desktop-Modules",
      "repository": "OpenShock/Desktop-Modules"
    }
  ]
}
